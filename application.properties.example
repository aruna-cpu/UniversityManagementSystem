
spring.application.name=UniversityManagementSystem
server.port=8080

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# Student Database
app.datasource.student.url=${STUDENT_DB_URL}
app.datasource.student.username=${STUDENT_DB_USERNAME}
app.datasource.student.password=${STUDENT_DB_PASSWORD}
app.datasource.student.driver-class-name=org.postgresql.Driver

# Course Database
app.datasource.course.url=${COURSE_DB_URL}
app.datasource.course.username=${COURSE_DB_USERNAME}
app.datasource.course.password=${COURSE_DB_PASSWORD}
app.datasource.course.driver-class-name=org.postgresql.Driver

# Grade Database
app.datasource.grade.url=${GRADE_DB_URL}
app.datasource.grade.username=${GRADE_DB_USERNAME}
app.datasource.grade.password=${GRADE_DB_PASSWORD}
app.datasource.grade.driver-class-name=org.postgresql.Driver